# SQLite (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Admin bootstrap (used by seed)
ADMIN_EMAIL="admin@domain.cloud"
ADMIN_PASSWORD="change-this-strong-password"
DEFAULT_DOMAIN="domain.cloud"

# Session cookie encryption (min 32 chars)
AUTH_SECRET="replace-with-long-random-string-32+"

# Cloudflare Worker → app inbound webhook
WEBHOOK_SECRET="replace-with-random-webhook-secret"

# Resend (https://resend.com) — required to actually send
RESEND_API_KEY="re_xxxxxxxx"

# Public URL of this panel (for docs / worker)
APP_URL="https://mail.domain.cloud"
PORT=3110

# Cloudflare Email Routing auto-sync (optional but recommended)
# Token needs: Zone Email Routing Rules Edit + Zone Read (zone x-me.cloud)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_EMAIL_WORKER="mail"
CLOUDFLARE_DISABLE_CATCHALL="true"

# Web Push (optional) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@domain.cloud"
